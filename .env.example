# Production uses HTTPS. See docker-compose.dev.yml for local HTTP testing.
APP_URL=https://send.example.com
# Bound to loopback by default. Public TLS is terminated by the host Nginx.
APP_PORT=8080
APP_BIND=127.0.0.1
ADMIN_USERNAME=admin
# Set a unique 12–72 byte password before first startup.
ADMIN_PASSWORD=
DATABASE_PATH=/data/database/linkbox.db
STORAGE_PATH=/data/files
CHUNK_PATH=/data/chunks
UPLOAD_CHUNK_SIZE=33554432
UPLOAD_CONCURRENCY=4
UPLOAD_EXPIRE_HOURS=24
MAX_FILE_SIZE=107374182400
STORAGE_RESERVED_BYTES=2147483648
MAX_ACTIVE_UPLOADS=100
MAX_UPLOADS_PER_USER=10
MAX_CHUNK_REQUESTS=16
# Generate with: openssl rand -hex 32
SESSION_SECRET=
LOG_LEVEL=info
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=172.30.48.0/24
COOKIE_SECURE=true
# Keep default 40m for 16/32 MiB chunks. Use 72m for 64 MiB chunks at EVERY Nginx hop.
NGINX_UPLOAD_BODY_SIZE=40m
